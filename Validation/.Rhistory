geom_col() +
coord_flip() +
labs(
title = "Taxa found in all datasets (≥10 reads)",
x = "taxon",
y = "total reads"
) + facet_wrap(~comparison) + scale_y_continuous(trans="log10") +
theme_test(base_size = 15)
