
#Get files
files <- list.files(pattern = "\\.rlen.txt$")
#Remove extensions
samples <- sub("\\..*", "",files)

#Load data into list
dframel <- lapply(files, function(file_name) {
			d <- read.table(file_name, header = FALSE, stringsAsFactors = FALSE)
			return (d[, c(2, 3)])
			}
		)
names(dframel) <- samples

svg("readlhist_grid.svg", width =6*6, height=7*6)
par(mfrow=c(6,6)) 
#Create plot
for (sample_name in samples) {
	current_df <- dframel[[sample_name]]
	plot(current_df[, 1], type='l', col="red", lwd=2, main=sample_name, xlab="Length", ylab="count", cex.main = 2,cex.lab = 1.5)
	lines(current_df[, 2],col = "blue",lwd = 2)
	legend("topright", legend = c("REF2.0", "REF3.0"), col = c("red", "blue"), lwd = 2, bty = "n")
}
dev.off()
	
